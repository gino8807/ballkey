<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>BallKey</vendor>
  <action id="org.ballkey.configure">
    <description>Change mouse and trackball button settings</description>
    <message>Authentication is required to change mouse and trackball button settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- At the computer: ask for the password, then remember it for a few minutes. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
