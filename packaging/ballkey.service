[Unit]
Description=BallKey mouse and trackball button remapper
# uinput (needed for the virtual device) is loaded by systemd-modules-load.
After=systemd-modules-load.service
# Fail-safe: if the daemon crashes 5 times within a minute, stop retrying
# so the device is left alone and works normally.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/ballkey/ballkeyd.py --config /etc/ballkey/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
